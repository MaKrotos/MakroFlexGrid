<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- NuGet packaging -->
    <PackageId>MakroFlexGrid</PackageId>
    <Version>1.0.0</Version>
    <Authors>MakroFlexGrid contributors</Authors>
    <Company>MakroFlexGrid</Company>
    <Description>
      Высокопроизводительный WPF DataGrid с виртуализацией строк,
      многоуровневыми заголовками, фильтрацией, сортировкой, агрегатами
      и широким набором типов ячеек.
    </Description>
    <PackageTags>wpf;datagrid;grid;ui;mvvm</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/MaKrotos/MakroFlexGrid</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MaKrotos/MakroFlexGrid</PackageProjectUrl>
    <PackageReleaseNotes>Первоначальный релиз пакета MakroFlexGrid.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- подавить предупреждения о недокументированных членах -->

    <!-- Assembly metadata -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MakroFlexGrid</Product>
    <Copyright>Copyright © 2026 MakroFlexGrid contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
