<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rows="clr-namespace:MakroFlexGrid.Rows">

    <!--
        Шаблон для редактируемой ячейки.
        В режиме просмотра показывает TextBlock.
        При клике переключается в режим редактирования (TextBox).
        Enter / LostFocus — сохранение значения.
        Escape — отмена.
    -->
    <DataTemplate x:Key="EditableCellTemplate">
        <Grid
            VerticalAlignment="Stretch"
            rows:EditableCellBehavior.IsEnabled="True"
            Background="Transparent">

            <!--  TextBlock (режим просмотра)  -->
            <TextBlock
                x:Name="DisplayText"
                Padding="4,0,4,0"
                VerticalAlignment="Center"
                IsHitTestVisible="True"
                Text="{Binding Value}"
                TextWrapping="NoWrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  TextBox (режим редактирования)  -->
            <TextBox
                x:Name="EditBox"
                Margin="4"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderThickness="1"
                Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>

    </DataTemplate>
</ResourceDictionary>