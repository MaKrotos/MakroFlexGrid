<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rows="clr-namespace:MakroFlexGrid.Rows">

    <DataTemplate x:Key="SystemCellTemplate">
        <Grid Background="White">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="(пусто)" IsEnabled="False" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Path Data="M 8,4 L 0,8 L 0,0 Z"
                  Fill="Gray"
                  Width="10" Height="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowViewModel.IsSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
