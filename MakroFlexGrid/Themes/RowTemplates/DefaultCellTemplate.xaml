<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="DefaultCellTemplate">
        <TextBlock
            Margin="6,2,6,2"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="#FF37474F"
            Text="{Binding Value}"
            TextWrapping="Wrap" />
    </DataTemplate>
</ResourceDictionary>