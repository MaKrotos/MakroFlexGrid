<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="DefaultCellTemplate">
        <TextBlock
            Padding="4,0,4,0"
            VerticalAlignment="Center"
            Text="{Binding Value}"
            TextWrapping="Wrap" />
    </DataTemplate>
</ResourceDictionary>