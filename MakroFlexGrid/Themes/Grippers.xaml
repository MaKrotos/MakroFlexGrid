<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:frozen="clr-namespace:MakroFlexGrid.FrozenSeparators"
    xmlns:headers="clr-namespace:MakroFlexGrid.Headers"
    xmlns:core="clr-namespace:MakroFlexGrid.Core">

    <!--  ColumnHeaderGripper: Thumb для ресайза колонок  -->
    <Style TargetType="{x:Type headers:ColumnHeaderGripper}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type headers:ColumnHeaderGripper}">
                    <Border Width="{TemplateBinding Width}" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type headers:LeftColumnHeaderGripper}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type headers:LeftColumnHeaderGripper}">
                    <Border Width="{TemplateBinding Width}" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RowSeparatorGripper: Thumb для ресайза frozen-панелей в строках  -->
    <Style TargetType="{x:Type frozen:RowSeparatorGripper}">
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type frozen:RowSeparatorGripper}">
                    <Border
                        x:Name="PART_Border"
                        Width="{TemplateBinding Width}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Border.ToolTip>
                            <ToolTip Visibility="Collapsed" />
                        </Border.ToolTip>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Подсветка при наведении на этот гриппер  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </Trigger>
                        <!--  Подсветка при захвате (перетаскивании) этого гриппера  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#66000000" />
                        </Trigger>
                        <!--  Синхронизированная подсветка: левый гриппер (IsRight=False) слушает IsLeftHighlighted  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsLeftHighlighted)}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsRight}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </MultiDataTrigger>
                        <!--  Синхронизированная подсветка: правый гриппер (IsRight=True) слушает IsRightHighlighted  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsRightHighlighted)}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsRight}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  HeaderSeparatorGripper: Thumb для ресайза frozen-панелей в заголовках  -->
    <Style TargetType="{x:Type headers:HeaderSeparatorGripper}">
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type headers:HeaderSeparatorGripper}">
                    <Border
                        x:Name="PART_Border"
                        Width="{TemplateBinding Width}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Border.ToolTip>
                            <ToolTip Visibility="Collapsed" />
                        </Border.ToolTip>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Подсветка при наведении на этот гриппер  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </Trigger>
                        <!--  Подсветка при захвате (перетаскивании) этого гриппера  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#66000000" />
                        </Trigger>
                        <!--  Синхронизированная подсветка: левый гриппер (IsRight=False) слушает IsLeftHighlighted  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsLeftHighlighted)}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsRight}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </MultiDataTrigger>
                        <!--  Синхронизированная подсветка: правый гриппер (IsRight=True) слушает IsRightHighlighted  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsRightHighlighted)}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsRight}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="#33000000" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>