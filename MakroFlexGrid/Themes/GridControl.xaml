<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:MakroFlexGrid.Core"
    xmlns:headers="clr-namespace:MakroFlexGrid.Headers"
    xmlns:rows="clr-namespace:MakroFlexGrid.Rows"
    xmlns:frozen="clr-namespace:MakroFlexGrid.FrozenSeparators">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MakroFlexGrid;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  CustomDataGrid: основной шаблон  -->
    <Style TargetType="{x:Type core:CustomDataGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type core:CustomDataGrid}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding GridLineBrush}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Шапка: ColumnHeadersPresenter (многоуровневые заголовки с ресайзом и сортировкой)  -->
                            <headers:ColumnHeadersPresenter
                                x:Name="PART_ColumnHeadersPresenter"
                                Grid.Row="0"
                                GridLineBrush="{TemplateBinding GridLineBrush}"
                                LeftFrozenPanelBackground="{TemplateBinding LeftFrozenPanelBackground}"
                                LeftMargin="{TemplateBinding LeftMargin}"
                                RightFrozenPanelBackground="{TemplateBinding RightFrozenPanelBackground}"
                                RightMargin="{TemplateBinding RightMargin}"
                                SeparatorBrush="{TemplateBinding SeparatorBrush}"
                                SeparatorWidth="{TemplateBinding SeparatorWidth}"
                                LeftFrozenColumnsCount="{Binding LeftFrozenColumnsCount, RelativeSource={RelativeSource TemplatedParent}}"
                                RightFrozenColumnsCount="{Binding RightFrozenColumnsCount, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="Visible" />

                            <!--  Содержимое (строки)  -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <rows:UnifiedRowsPresenter
                                    x:Name="PART_CentralRowsPresenter"
                                    Grid.ColumnSpan="3"
                                    SeparatorBrush="{TemplateBinding SeparatorBrush}"
                                    SeparatorWidth="{TemplateBinding SeparatorWidth}" />
                            </Grid>

                            <!--  Нижняя панель с итоговыми значениями (над горизонтальным ScrollBar)  -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Height="5"
                                    Background="LightGray" />
                                <rows:BottomPanelPresenter
                                    x:Name="PART_BottomPanelPresenter"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    HorizontalAlignment="Left"

                                    SeparatorBrush="{TemplateBinding SeparatorBrush}"
                                    SeparatorWidth="{TemplateBinding SeparatorWidth}"
                                    ShowBottomCellBorders="{TemplateBinding ShowBottomCellBorders}"
                                    BottomPanelHeight="{TemplateBinding BottomPanelHeight}"
                                    Visibility="{Binding HasAggregates, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Grid
                                    Grid.Row="2"
                                    Height="1"
                                    Background="LightGray" />
                            </Grid>

                            <!--  Горизонтальный ScrollBar  -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="PART_LeftScrollBarSpacer"
                                    Grid.Column="0"
                                    Width="0"
                                    Visibility="{Binding ShowScrollBarSpacers, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Orientation="Horizontal"
                                    SmallChange="16" />

                                <Border
                                    x:Name="PART_RightScrollBarSpacer"
                                    Grid.Column="2"
                                    Width="0"
                                    Margin="{TemplateBinding RightMargin}"
                                    Visibility="{Binding ShowScrollBarSpacers, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  UnifiedRowsItemsControl: ItemsControl со ScrollViewer и  -->
    <!--  VirtualizingStackPanel для виртуализации строк  -->
    <Style TargetType="{x:Type rows:UnifiedRowsItemsControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rows:UnifiedRowsItemsControl}">
                    <ScrollViewer
                        x:Name="PART_ScrollViewer"
                        Padding="{TemplateBinding Padding}"
                        CanContentScroll="True"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        CanHorizontallyScroll="False"
                        IsVirtualizing="True"
                        Orientation="Vertical"
                        VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingStackPanel.CacheLength="2"
                        VirtualizingStackPanel.CacheLengthUnit="Page" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>