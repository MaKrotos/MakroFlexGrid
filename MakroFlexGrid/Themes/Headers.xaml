<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:MakroFlexGrid.Core"
    xmlns:frozen="clr-namespace:MakroFlexGrid.FrozenSeparators"
    xmlns:headers="clr-namespace:MakroFlexGrid.Headers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MakroFlexGrid;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ColumnHeader: ButtonBase для отображения заголовка колонки  -->
    <Style TargetType="{x:Type headers:ColumnHeader}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="LightGray" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type headers:ColumnHeader}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Содержимое заголовка + стрелка сортировки + иконка фильтра  -->
                            <!--  Margin="0,0,0,0" — отступы под зону захвата Gripper (ширина 8px)  -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    RecognizesAccessKey="True" />

                                <!--  Стрелка сортировки  -->
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Width="8"
                                    Height="8"
                                    Margin="3,0,0,0"
                                    Data="M0,0 L4,6 L8,0 Z"
                                    Fill="Gray"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />

                                <!--  Иконка фильтра (воронка)  -->
                                <Path
                                    x:Name="FilterIcon"
                                    Grid.Column="2"
                                    Width="10"
                                    Height="10"
                                    Margin="3,0,0,0"
                                    Data="M0,0 L4,0 L4,2 L2,4 L2,6 L6,6 L6,4 L4,2 L4,0 L8,0 L8,1 L5,5 L5,8 L3,8 L3,5 L0,1 Z"
                                    Fill="#FF8C00"
                                    Stretch="Uniform"
                                    ToolTip="Фильтр активен"
                                    Visibility="Collapsed" />
                            </Grid>

                            <!--  Gripper для ресайза (слева) — накладывается поверх контента  -->
                            <headers:LeftColumnHeaderGripper
                                x:Name="PART_LeftHeaderGripper"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch" />

                            <!--  Gripper для ресайза (справа) — накладывается поверх контента  -->
                            <headers:ColumnHeaderGripper
                                x:Name="PART_RightHeaderGripper"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Показываем стрелку сортировки  -->
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="M0,6 L4,0 L8,6 Z" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L4,6 L8,0 Z" />
                        </Trigger>

                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5F3FF" />
                        </Trigger>

                        <!--  Pressed  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#CCE8FF" />
                        </Trigger>

                        <!--  Drag & Drop: перетаскиваемый заголовок становится полупрозрачным  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!--  Drag & Drop: целевой заголовок подсвечивается рамкой и фоном  -->
                        <Trigger Property="IsDropTarget" Value="True">
                            <Setter Property="Background" Value="#1A1E90FF" />
                            <Setter Property="BorderBrush" Value="#1E90FF" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!--  Фильтр активен: показываем иконку фильтра  -->
                        <Trigger Property="IsFilterActive" Value="True">
                            <Setter TargetName="FilterIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ColumnHeadersPresenter: Control для многоуровневых заголовков  -->
    <Style TargetType="{x:Type headers:ColumnHeadersPresenter}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type headers:ColumnHeadersPresenter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Левая замороженная шапка с фоном и границей  -->
                        <Border
                            x:Name="PART_LeftFrozenBorder"
                            Grid.Column="0"
                            Margin="{TemplateBinding LeftMargin}"
                            Background="{TemplateBinding LeftFrozenPanelBackground}"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid x:Name="PART_FrozenHeadersWrapper" ClipToBounds="True" />
                        </Border>

                        <!--  Разделитель слева (между левыми frozen и scrollable)  -->
                        <headers:HeaderSeparatorGripper
                            x:Name="PART_LeftHeaderSeparator"
                            Grid.Column="1"
                            Width="{TemplateBinding SeparatorWidth}"
                            Background="{TemplateBinding SeparatorBrush}"
                            IsRight="False"
                            SnapsToDevicePixels="True">
                            <headers:HeaderSeparatorGripper.Visibility>
                                <MultiBinding Converter="{StaticResource FrozenSeparatorVisibilityConverter}">
                                    <Binding RelativeSource="{RelativeSource AncestorType=headers:ColumnHeadersPresenter}" Path="SeparatorWidth" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=headers:ColumnHeadersPresenter}" Path="LeftFrozenColumnsCount" />
                                </MultiBinding>
                            </headers:HeaderSeparatorGripper.Visibility>
                        </headers:HeaderSeparatorGripper>

                        <!--  Скроллируемая часть заголовков  -->
                        <ScrollViewer
                            x:Name="PART_HeadersScrollViewer"
                            Grid.Column="2"
                            Background="{TemplateBinding Background}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                            <Grid x:Name="PART_HeadersWrapper" ClipToBounds="True" />
                        </ScrollViewer>

                        <!--  Разделитель справа (между scrollable и правыми frozen)  -->
                        <headers:HeaderSeparatorGripper
                            x:Name="PART_RightHeaderSeparator"
                            Grid.Column="3"
                            Width="{TemplateBinding SeparatorWidth}"
                            Background="{TemplateBinding SeparatorBrush}"
                            IsRight="True"
                            SnapsToDevicePixels="True">
                            <headers:HeaderSeparatorGripper.Visibility>
                                <MultiBinding Converter="{StaticResource FrozenSeparatorVisibilityConverter}">
                                    <Binding RelativeSource="{RelativeSource AncestorType=headers:ColumnHeadersPresenter}" Path="SeparatorWidth" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=headers:ColumnHeadersPresenter}" Path="RightFrozenColumnsCount" />
                                </MultiBinding>
                            </headers:HeaderSeparatorGripper.Visibility>
                        </headers:HeaderSeparatorGripper>

                        <!--  Правая замороженная шапка с фоном и границей  -->
                        <Border
                            x:Name="PART_RightFrozenBorder"
                            Grid.Column="4"
                            Margin="{TemplateBinding RightMargin}"
                            Background="{TemplateBinding RightFrozenPanelBackground}"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid x:Name="PART_RightFrozenHeadersWrapper" ClipToBounds="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Синхронизированная подсветка левого разделителя в шапке  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsLeftHighlighted)}" Value="True">
                            <Setter TargetName="PART_LeftHeaderSeparator" Property="Background" Value="#33000000" />
                        </DataTrigger>
                        <!--  Синхронизированная подсветка правого разделителя в шапке  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=core:CustomDataGrid}, Path=(frozen:RowSeparatorHighlight.IsRightHighlighted)}" Value="True">
                            <Setter TargetName="PART_RightHeaderSeparator" Property="Background" Value="#33000000" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>