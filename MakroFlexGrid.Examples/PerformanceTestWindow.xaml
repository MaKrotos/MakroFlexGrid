<Window
    x:Class="MakroFlexGrid.TestWindows.PerformanceTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:TestWindows="clr-namespace:MakroFlexGrid.TestWindows"
    xmlns:core="clr-namespace:MakroFlexGrid.Core;assembly=MakroFlexGrid"
    xmlns:headers="clr-namespace:MakroFlexGrid.Headers;assembly=MakroFlexGrid"
    Title="MakroFlexGrid — Демонстрация возможностей"
    Width="1440"
    Height="860"
    MinWidth="1100"
    MinHeight="700"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  ================================================================  -->
        <!--  BOTTOM CELL TEMPLATES (панель итогов)  -->
        <!--  ================================================================  -->

        <!--  Числовые значения в итогах: сумма с форматированием  -->
        <DataTemplate x:Key="NumberBottomCellTemplate">
            <Border
                Margin="1,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
                <TextBlock
                    Margin="6,2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding Value, StringFormat={}{0:N0}}" />
            </Border>
        </DataTemplate>

        <!--  Статус в итогах: текст  -->
        <DataTemplate x:Key="StatusBottomCellTemplate">
            <TextBlock
                Margin="6,2"
                VerticalAlignment="Center"
                FontSize="12"
                FontStyle="Italic"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding Value}" />
        </DataTemplate>

        <!--  Дата в итогах  -->
        <DataTemplate x:Key="DateBottomCellTemplate">
            <TextBlock
                Margin="6,2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding Value}" />
        </DataTemplate>

        <!--  Булево в итогах  -->
        <DataTemplate x:Key="BooleanBottomCellTemplate">
            <TextBlock
                Margin="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding Value}" />
        </DataTemplate>

        <!--  ID в итогах  -->
        <DataTemplate x:Key="IdBottomCellTemplate">
            <TextBlock
                Margin="6,2"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFontFamily}"
                FontSize="11"
                Foreground="{StaticResource TextMutedBrush}"
                Text="{Binding Value}" />
        </DataTemplate>

        <!--  ================================================================  -->
        <!--  HEADER TEMPLATES  -->
        <!--  ================================================================  -->

        <!--  Заголовок-кнопка (спокойная, без кричащего жёлтого)  -->
        <DataTemplate x:Key="HeaderButtonTemplate">
            <Button
                Height="34"
                Margin="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{StaticResource AccentLightBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                Content="{Binding}"
                Foreground="{StaticResource AccentDarkBrush}"
                Style="{StaticResource ActionButtonStyle}" />
        </DataTemplate>

        <!--  Заголовок с градиентным акцентом  -->
        <DataTemplate x:Key="HeaderColoredTemplate">
            <Border Margin="-5,-3" SnapsToDevicePixels="True">
                <Border.Background>
                    <StaticResource ResourceKey="HeaderColoredGradient" />
                </Border.Background>
                <TextBlock
                    Margin="8,3"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <!--  Заголовок листовой колонки: аккуратная галочка + текст  -->
        <DataTemplate x:Key="HeaderLeafWithIconTemplate">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SuccessBrush}"
                    Text="✓" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================================================================  -->
        <!--  ШАПКА  -->
        <!--  ================================================================  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,14"
            Padding="18,14"
            Background="{StaticResource HeaderBarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="MakroFlexGrid" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Демонстрация типов ячеек, замороженных зон, фильтрации, сортировки и итогов" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="CustomDataGrid · WPF" />
            </Grid>
        </Border>

        <!--  ================================================================  -->
        <!--  КАРТОЧКА С ГРИДОМ  -->
        <!--  ================================================================  -->
        <Grid Grid.Row="1">
            <Border
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="270"
                        Opacity="0.08"
                        ShadowDepth="3"
                        Color="#1A2B3C" />
                </Border.Effect>
            </Border>

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Панель управления  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Padding="10,8"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Кнопки загрузки данных  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,4,8,4"
                                Click="Button_Click"
                                Content="Загрузить 5"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                Margin="0,4,8,4"
                                Click="Load1k_Click"
                                Content="1 тыс."
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                Margin="0,4,8,4"
                                Click="Load10k_Click"
                                Content="10 тыс."
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                Margin="0,4,8,4"
                                Click="Load50k_Click"
                                Content="50 тыс."
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                Margin="0,4,8,4"
                                Click="StartScrollTest_Click"
                                Content="Тест прокрутки"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                Margin="20,4,4,4"
                                Click="Clear_Click"
                                Content="Очистить"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <!--  Статус загрузки  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="StatusText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Готово" />
                            <TextBlock
                                x:Name="FPSText"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="13"
                                Foreground="{StaticResource AccentDarkBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Тестируемый DataGrid  -->
                <core:CustomDataGrid
                    x:Name="TestGrid"
                    Grid.Row="1"
                    AllowDrag="True"
                    AutoGenerateColumns="False"
                    BottomPanelBackground="{StaticResource PanelBackgroundBrush}"
                    BottomPanelText="Итоги"
                    BottomPanelTextPosition="Bottom"
                    CellSelectedBorderBrush="{StaticResource AccentBrush}"
                    CellSelectedBorderThickness="1"
                    CenterPanelBackground="Transparent"
                    GridLineBrush="#E4E9F0"
                    IsCellSelectionEnabled="True"
                    IsSystemColumnEnabled="True"
                    LeftFrozenPanelBackground="#F2F6FA"
                    PanelTextAlignment="Left"
                    PanelTextPadding="10,5,10,5"
                    RightFrozenPanelBackground="#F2F6FA"
                    RowBackground="White"
                    RowSelectedBackground="#E4EDF7"
                    RowSelectionMode="Single"
                    SeparatorBrush="{StaticResource BorderStrongBrush}"
                    SeparatorWidth="14"
                    ShowBottomCellBorders="False"
                    ShowScrollBarSpacers="True">

                    <!--  ====================================================  -->
                    <!--  ЗАМОРОЖЕННЫЕ (ЛЕВЫЕ) — базовые колонки  -->
                    <!--  ====================================================  -->
                    <core:CustomDataGrid.FrozenColumnHeaders>
                        <headers:ColumnHeaderGroup
                            Width="200"
                            CanUserSort="False"
                            Header="Базовые"
                            HeaderTemplate="{StaticResource HeaderColoredTemplate}">
                            <headers:ColumnHeaderLeaf
                                Width="60"
                                BottomCellTemplate="{StaticResource IdBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="ID"
                                SortDataType="Number"
                                SortMemberPath="Id" />
                            <headers:ColumnHeaderLeaf
                                Width="140"
                                BottomCellTemplate="{StaticResource StatusBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Имя"
                                SortDataType="Text"
                                SortMemberPath="Name" />
                            <headers:EditableColumnHeaderLeaf
                                Width="150"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Описание (ред.)"
                                SortDataType="Text"
                                SortMemberPath="Description" />
                        </headers:ColumnHeaderGroup>
                    </core:CustomDataGrid.FrozenColumnHeaders>

                    <!--  ====================================================  -->
                    <!--  СКРОЛЛИРУЕМЫЕ — все типы ячеек  -->
                    <!--  ====================================================  -->
                    <core:CustomDataGrid.ScrollableColumnHeaders>
                        <headers:ColumnHeaderGroup
                            Width="500"
                            CanUserSort="False"
                            Header="Новые типы ячеек"
                            HeaderTemplate="{StaticResource HeaderColoredTemplate}">

                            <!--  1. NumericCell: числовое поле  -->
                            <headers:NumericColumnHeaderLeaf
                                Width="120"
                                AggregateType="Sum"
                                BottomCellTemplate="{StaticResource NumberBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                CurrencySymbol="₽"
                                DecimalPlaces="2"
                                Header="Цена"
                                MaxValue="999999"
                                MinValue="0"
                                SortDataType="Number"
                                SortMemberPath="Price" />

                            <!--  2. CheckBoxCell: флажок  -->
                            <headers:CheckBoxColumnHeaderLeaf
                                Width="80"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Чек"
                                IsThreeState="False"
                                SortDataType="Text"
                                SortMemberPath="IsChecked" />

                            <!--  3. DateCell: дата  -->
                            <headers:DateColumnHeaderLeaf
                                Width="130"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Format="dd.MM.yyyy"
                                Header="Дата"
                                SortDataType="Date"
                                SortMemberPath="Date" />

                            <!--  4. HyperlinkCell: гиперссылка  -->
                            <headers:HyperlinkColumnHeaderLeaf
                                Width="150"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Ссылка"
                                SortDataType="Text"
                                SortMemberPath="Url" />

                            <!--  5. ProgressCell: полоса прогресса  -->
                            <headers:ProgressColumnHeaderLeaf
                                Width="120"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Прогресс"
                                Maximum="100"
                                Minimum="0"
                                ShowPercentage="True"
                                SortDataType="Number"
                                SortMemberPath="Progress" />

                            <!--  6. ImageCell: изображение  -->
                            <headers:ImageColumnHeaderLeaf
                                Width="80"
                                MaxWidth="60"
                                MaxHeight="40"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Фото"
                                SortDataType="Text"
                                SortMemberPath="ImageUrl"
                                Stretch="Uniform" />

                            <!--  7. RatingCell: рейтинг звёздами  -->
                            <headers:RatingColumnHeaderLeaf
                                Width="120"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Рейтинг"
                                MaxRating="5"
                                SortDataType="Number"
                                SortMemberPath="Rating" />

                            <!--  8. ColorCell: цветной прямоугольник  -->
                            <headers:ColorColumnHeaderLeaf
                                Width="100"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Цвет"
                                ShowColorName="True"
                                SortDataType="Text"
                                SortMemberPath="Color" />

                            <!--  9. MultiLineTextCell: многострочный текст  -->
                            <headers:MultiLineColumnHeaderLeaf
                                Width="150"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Многострочный"
                                MaxLines="5"
                                SortDataType="Text"
                                SortMemberPath="MultiLineText" />

                            <!--  10. RadioButtonCell: радиокнопки  -->
                            <headers:RadioButtonColumnHeaderLeaf
                                Width="180"
                                CanUserFilter="True"
                                CanUserSort="True"
                                GroupName="RadioGroup"
                                Header="Выбор"
                                Options="{Binding Source={x:Static TestWindows:TestItem.RadioOptions}}"
                                SortDataType="Text"
                                SortMemberPath="RadioOption" />
                        </headers:ColumnHeaderGroup>

                        <!--  Стандартные колонки (DefaultCell, ComboBoxCell)  -->
                        <headers:ColumnHeaderGroup
                            Width="250"
                            CanUserSort="False"
                            Header="Стандартные"
                            HeaderTemplate="{StaticResource HeaderColoredTemplate}">
                            <headers:ColumnHeaderLeaf
                                Width="100"
                                AggregateType="Sum"
                                BottomCellTemplate="{StaticResource NumberBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Значение"
                                SortDataType="Number"
                                SortMemberPath="Value" />
                            <headers:ColumnHeaderLeaf
                                Width="80"
                                BottomCellTemplate="{StaticResource BooleanBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Активен"
                                SortDataType="Text"
                                SortMemberPath="IsActive" />
                            <headers:ComboBoxColumnHeaderLeaf
                                Width="120"
                                CanUserFilter="True"
                                CanUserSort="True"
                                DisplayMemberPath="."
                                Header="Категория"
                                HeaderTemplate="{StaticResource HeaderLeafWithIconTemplate}"
                                ItemsSource="{Binding Source={x:Static TestWindows:TestItem.Categories}}"
                                SelectedValueBinding="Category"
                                SelectedValuePath="."
                                SortDataType="Text"
                                SortMemberPath="Category" />
                        </headers:ColumnHeaderGroup>
                    </core:CustomDataGrid.ScrollableColumnHeaders>

                    <!--  ====================================================  -->
                    <!--  ЗАМОРОЖЕННЫЕ (ПРАВЫЕ) — статус и дата  -->
                    <!--  ====================================================  -->
                    <core:CustomDataGrid.RightFrozenColumnHeaders>
                        <headers:ColumnHeaderGroup
                            Width="180"
                            AllowCrossSectionDrag="False"
                            CanUserSort="False"
                            Header="Сводка"
                            HeaderTemplate="{StaticResource HeaderColoredTemplate}">
                            <headers:ColumnHeaderLeaf
                                Width="100"
                                BottomCellTemplate="{StaticResource StatusBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Статус"
                                HeaderTemplate="{StaticResource HeaderLeafWithIconTemplate}"
                                SortDataType="Text"
                                SortMemberPath="Status" />
                            <headers:ColumnHeaderLeaf
                                Width="80"
                                BottomCellTemplate="{StaticResource DateBottomCellTemplate}"
                                CanUserFilter="True"
                                CanUserSort="True"
                                Header="Дата"
                                HeaderTemplate="{StaticResource HeaderLeafWithIconTemplate}"
                                SortDataType="Date"
                                SortMemberPath="Date" />
                        </headers:ColumnHeaderGroup>
                    </core:CustomDataGrid.RightFrozenColumnHeaders>

                    <core:CustomDataGrid.PanelTextTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentDarkBrush}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </core:CustomDataGrid.PanelTextTemplate>
                </core:CustomDataGrid>
            </Grid>
        </Grid>

        <!--  ================================================================  -->
        <!--  СТАТУС-БАР МЕТРИК  -->
        <!--  ================================================================  -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="14,8"
            Background="{StaticResource HeaderBarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="Память: " />
                    <TextBlock
                        x:Name="MemoryText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="Время загрузки: " />
                    <TextBlock
                        x:Name="TimeText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="Строк: " />
                    <TextBlock
                        x:Name="RowCountText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>